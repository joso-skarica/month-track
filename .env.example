# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend email (required for sending reminders)
RESEND_API_KEY=re_your_api_key

# Email sender address (required for production)
# Must be a verified domain in your Resend account.
# Example: Month-Track <noreply@yourdomain.com>
EMAIL_FROM=Month-Track <onboarding@resend.dev>
